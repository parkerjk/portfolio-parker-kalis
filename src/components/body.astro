		<script is:inline>
			const body = document.body;
			const fireworkCanvas = document.getElementById('fireworks-background');
			const fireworkButton = document.querySelector('.fireworks-toggle');
			const ctx = fireworkCanvas.getContext('2d');
			let animationFrameId = null;
			let fireworks = [];
			let dots = [];
			//let stars = [];
			let active = false;

			function resizeCanvas() {
				const dpr = window.devicePixelRatio || 1;
				fireworkCanvas.width = window.innerWidth * dpr;
				fireworkCanvas.height = window.innerHeight * dpr;
				fireworkCanvas.style.width = window.innerWidth + 'px';
				fireworkCanvas.style.height = window.innerHeight + 'px';
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			}

			/*
			function seedStars() {
				stars = [];
				for (let i = 0; i < 55; i += 1) {
					stars.push({
						x: Math.random() * window.innerWidth,
						y: Math.random() * window.innerHeight,
						radius: Math.random() * 2.2 + 0.8
					});
				}
			}
			*/

			function createFirework() {
				const startX = Math.random() * window.innerWidth;
				const startY = window.innerHeight;
				const endX = Math.random() * window.innerWidth;
				const endY = Math.random() * (window.innerHeight * 0.7);
				const r = Math.random() * 255;
				const g = Math.random() * 255;
				const b = Math.random() * 255;
				fireworks.push({ startX, startY, endX, endY, r, g, b, time: 0 });
			}

			function drawStarfield() {
				const gradient = ctx.createLinearGradient(0, 0, 0, window.innerHeight);
				gradient.addColorStop(0, '#182848');
				gradient.addColorStop(1, '#4b6cb7');
				ctx.fillStyle = gradient;
				ctx.fillRect(0, 0, window.innerWidth, window.innerHeight);
				/*
				for (const star of stars) {
					ctx.beginPath();
					ctx.fillStyle = '#f5f5ef';
					ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
					ctx.fill();
				}
				*/
			}

			function animateFireworks() {
				ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
				drawStarfield();

				if (Math.random() > 0.8) {
					createFirework();
				}

				for (let i = fireworks.length - 1; i >= 0; i -= 1) {
					const firework = fireworks[i];
					const currentX = (1 - firework.time) * firework.startX + firework.time * firework.endX;
					const currentY = (1 - firework.time) * firework.startY + firework.time * firework.endY;

					ctx.fillStyle = 'rgb(' + firework.r + ', ' + firework.g + ', ' + firework.b + ')';
					ctx.fillRect(currentX - 5, currentY - 5, 10, 10);

					firework.time += 0.008;
					if (firework.time >= 1) {
						fireworks.splice(i, 1);
						const dotColorR = Math.random() * 255;
						const dotColorG = Math.random() * 255;
						const dotColorB = Math.random() * 255;

						for (let j = 0; j < 18 + Math.random() * 18; j += 1) {
							dots.push({
								x: firework.endX,
								y: firework.endY,
								s: 3,
								vx: (Math.random() - 0.5) * 6,
								vy: (Math.random() - 0.5) * 6,
								r: dotColorR,
								g: dotColorG,
								b: dotColorB
							});
						}
					}
				}

				for (let i = dots.length - 1; i >= 0; i -= 1) {
					const dot = dots[i];
					dot.x += dot.vx;
					dot.y += dot.vy;
					dot.r -= 2.5;
					dot.g -= 2.5;
					dot.b -= 2.5;
					ctx.fillStyle = 'rgb(' + Math.max(0, dot.r) + ', ' + Math.max(0, dot.g) + ', ' + Math.max(0, dot.b) + ')';
					ctx.fillRect(dot.x - dot.s, dot.y - dot.s, dot.s * 2, dot.s * 2);

					if (dot.x < 0 || dot.x > window.innerWidth || dot.y < 0 || dot.y > window.innerHeight || dot.r < 10 || dot.g < 10 || dot.b < 10) {
						dots.splice(i, 1);
					}
				}

				animationFrameId = window.requestAnimationFrame(animateFireworks);
			}

			function stopFireworks() {
				active = false;
				fireworkButton.setAttribute('aria-pressed', 'false');
				body.classList.remove('fireworks-on');
				if (animationFrameId) {
					window.cancelAnimationFrame(animationFrameId);
					animationFrameId = null;
				}
				ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
				fireworks = [];
				dots = [];
			}

			function startFireworks() {
				if (active) {
					return;
				}
				active = true;
				fireworkButton.setAttribute('aria-pressed', 'true');
				body.classList.add('fireworks-on');
				//seedStars();
				fireworks = [];
				dots = [];
				animationFrameId = window.requestAnimationFrame(animateFireworks);
			}

			fireworkButton.addEventListener('click', () => {
				if (active) {
					stopFireworks();
				} else {
					startFireworks();
				}
			});

			window.addEventListener('resize', () => {
				resizeCanvas();
				/*
				if (active) {
					seedStars();
				}
				*/
			});

			resizeCanvas();
		</script>
